{
  "name": "aspnet-buildtools",
  "version": "0.3.2",
  "description": "Vite and Webpack entry points and import aliases generated from ASP.NET Core Razor views",
  "keywords": [
    "aspnetcore",
    "asp.net",
    "razor",
    "razor-pages",
    "mvc",
    "vite",
    "vite-plugin",
    "webpack",
    "entry-points",
    "aliases",
    "dotnet"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baune8D/aspnet-buildtools.git"
  },
  "author": "Baune8D",
  "homepage": "https://github.com/Baune8D/aspnet-buildtools#readme",
  "bugs": "https://github.com/Baune8D/aspnet-buildtools/issues",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/**/**",
    "!**/*.tsbuildinfo",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/node": "^24.19.2",
    "@types/webpack": "^5.28.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "scripts": {
    "format": "prettier --write . && eslint --fix .",
    "lint": "eslint \"**/*.{ts,mjs}\" --max-warnings=0 --report-unused-disable-directives",
    "test": "NODE_NO_WARNINGS=1 node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">= 22"
  }
}
